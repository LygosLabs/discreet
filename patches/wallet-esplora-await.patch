+  ): string {
+    const kind =
+      keychain === 'external' ? KeychainKind.External : KeychainKind.Internal;
+    return this.bdk.peekAddress(kind, index).address.toString();
+  }
+
+  /** Highest index handed out so far, or undefined if none. */
+  revealedIndex(
